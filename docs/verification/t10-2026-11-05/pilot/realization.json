                "text": "The walls",
                "originalText": "The walls",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-0-1",
                "text": "Collapse, like the seal",
                "originalText": "Collapse, like the seal",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-0-2",
                "text": "youve sown:",
                "originalText": "youve sown:",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-1-0",
                "text": "The walls",
                "originalText": "The walls",
                "blockType": "text",
                "breakBefore": true
              },
              {
                "lineId": "diary1-1-1",
                "text": "The walls",
                "originalText": "The walls",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-1-2",
                "text": "Collapse, and the seal is",
                "originalText": "Collapse, and the seal is",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-1-3",
                "text": "Gone ?",
                "originalText": "Gone ?",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-2-0",
                "text": "A minotaur with no maze",
                "originalText": "A minotaur with no maze",
                "blockType": "text",
                "breakBefore": true
              },
              {
                "lineId": "diary1-2-1",
                "text": "to call his home, a life,",
                "originalText": "to call his home, a life,",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-2-2",
                "text": "A burden, a stepping",
                "originalText": "A burden, a stepping",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-2-3",
                "text": "stone.",
                "originalText": "stone.",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-3-0",
                "text": "The walls —",
                "originalText": "The walls —",
                "blockType": "text",
                "breakBefore": true
              },
              {
                "lineId": "diary1-3-1",
                "text": "They were simple, they had grace —",
                "originalText": "They were simple, they had grace —",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-3-2",
                "text": "Stood without your embrace",
                "originalText": "Stood without your embrace",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-3-3",
                "text": "Or the face of others",
                "originalText": "Or the face of others",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-4-0",
                "text": "A myth that was true, a myth",
                "originalText": "A myth that was true, a myth",
                "blockType": "text",
                "breakBefore": true
              },
              {
                "lineId": "diary1-4-1",
                "text": "perused, or a passing gaze",
                "originalText": "perused, or a passing gaze",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-4-2",
                "text": "with not a moment wasted.",
                "originalText": "with not a moment wasted.",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-5-0",
                "text": "Poor minotaur,",
                "originalText": "Poor minotaur,",
                "blockType": "text",
                "breakBefore": true
              },
              {
                "lineId": "diary1-5-1",
                "text": "Where are you now? Have you lost",
                "originalText": "Where are you now? Have you lost",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-5-2",
                "text": "That frown",
                "originalText": "That frown",
                "blockType": "text",
                "breakBefore": false
              },
              {
                "lineId": "diary1-5-3",
                "text": "Of that which you were so fond ?",
                "originalText": "Of that which you were so fond ?",
                "blockType": "text",
                "breakBefore": false
